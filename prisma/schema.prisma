generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  technician
  admin
}

enum AccountType {
  personal
  business
}

enum ProductStatus {
  active
  archived
}

enum PriceModel {
  fixed
  starting_at
  quote
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  completed
  cancelled
}

enum PaymentMethod {
  cod
  simulated
}

enum PaymentStatus {
  unpaid
  authorized
}

enum BookingStatus {
  requested
  confirmed
  assigned
  scheduled
  in_progress
  completed
  cancelled
}

enum SolutionStatus {
  submitted
  quoted
  accepted
  rejected
}

model User {
  id                  String                 @id @default(uuid()) @db.Uuid
  name                String
  email               String                 @unique
  passwordHash        String
  role                UserRole               @default(customer)
  isActive            Boolean                @default(true)
  scheduleVersion     Int                    @default(0)
  accountType         AccountType            @default(personal)
  businessDiscountBps Int                    @default(0)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  cart                Cart?
  orders              Order[]
  bookings            ServiceBooking[]       @relation("customerBookings")
  assignedBookings    ServiceBooking[]       @relation("technicianBookings")
  reviews             Review[]
  wishlist            Wishlist?
  notifications       Notification[]
  solutions           SolutionRequest[]
  orderChanges        OrderStatusHistory[]
  bookingChanges      BookingStatusHistory[]

  @@index([role, isActive])
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String    @default("")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id          String                 @id @default(uuid()) @db.Uuid
  name        String
  sku         String                 @unique
  categoryId  String                 @db.Uuid
  category    Category               @relation(fields: [categoryId], references: [id])
  brand       String
  description String
  tags        String[]
  imageUrls   String[]
  price       Int
  discount    Int                    @default(0)
  stock       Int                    @default(0)
  specs       Json                   @default("{}")
  warranty    String                 @default("")
  status      ProductStatus          @default(active)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  cartItems   CartItem[]
  bundleItems BundleProduct[]
  orderItems  OrderItem[]
  reviews     Review[]
  wishlists   WishlistProduct[]
  quoteItems  SolutionQuoteProduct[]

  @@index([categoryId])
  @@index([brand])
  @@index([status, categoryId, brand, price])
}

model Cart {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @unique @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CartItem[]
  bundleItems CartBundleItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model CartItem {
  cartId    String  @db.Uuid
  productId String  @db.Uuid
  quantity  Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@id([cartId, productId])
}

model CartBundleItem {
  cartId   String @db.Uuid
  bundleId String @db.Uuid
  quantity Int
  cart     Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  bundle   Bundle @relation(fields: [bundleId], references: [id])

  @@id([cartId, bundleId])
}

model Service {
  id              String                 @id @default(uuid()) @db.Uuid
  name            String
  category        String
  description     String
  priceModel      PriceModel
  basePrice       Int
  durationMinutes Int
  isActive        Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  bookings        ServiceBooking[]
  bundles         BundleService[]
  orderBundles    OrderBundleService[]
  quoteServices   SolutionQuoteService[]

  @@index([isActive, category, name])
}

model Bundle {
  id           String            @id @default(uuid()) @db.Uuid
  name         String
  description  String
  bundlePrice  Int
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  productItems BundleProduct[]
  services     BundleService[]
  cartItems    CartBundleItem[]
  orderItems   OrderBundleItem[]
  sourcedItems OrderItem[]

  @@index([isActive, createdAt])
}

model BundleProduct {
  bundleId  String  @db.Uuid
  productId String  @db.Uuid
  quantity  Int
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@id([bundleId, productId])
}

model BundleService {
  bundleId  String  @db.Uuid
  serviceId String  @db.Uuid
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id])

  @@id([bundleId, serviceId])
}

model Order {
  id                  String               @id @default(uuid()) @db.Uuid
  orderNumber         String               @unique
  userId              String               @db.Uuid
  user                User                 @relation(fields: [userId], references: [id])
  subtotal            Int
  discountTotal       Int
  grandTotal          Int
  currency            String               @default("BDT")
  paymentMethod       PaymentMethod        @default(cod)
  paymentStatus       PaymentStatus        @default(unpaid)
  paymentReference    String?
  status              OrderStatus          @default(pending)
  shippingAddress     String
  inventoryRestoredAt DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  items               OrderItem[]
  bundleItems         OrderBundleItem[]
  statusHistory       OrderStatusHistory[]
  solution            SolutionRequest?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @db.Uuid
  productId      String  @db.Uuid
  sourceBundleId String? @db.Uuid
  nameSnapshot   String
  skuSnapshot    String
  quantity       Int
  unitPrice      Int
  lineTotal      Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])
  sourceBundle   Bundle? @relation(fields: [sourceBundleId], references: [id])
}

model OrderBundleItem {
  id           String               @id @default(uuid()) @db.Uuid
  orderId      String               @db.Uuid
  bundleId     String               @db.Uuid
  nameSnapshot String
  quantity     Int
  unitPrice    Int
  lineTotal    Int
  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bundle       Bundle               @relation(fields: [bundleId], references: [id])
  services     OrderBundleService[]
}

model OrderBundleService {
  orderBundleItemId String          @db.Uuid
  serviceId         String          @db.Uuid
  orderBundleItem   OrderBundleItem @relation(fields: [orderBundleItemId], references: [id], onDelete: Cascade)
  service           Service         @relation(fields: [serviceId], references: [id])

  @@id([orderBundleItemId, serviceId])
}

model OrderStatusHistory {
  id        String       @id @default(uuid()) @db.Uuid
  orderId   String       @db.Uuid
  from      OrderStatus?
  to        OrderStatus
  changedBy String       @db.Uuid
  changedAt DateTime     @default(now())
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor     User         @relation(fields: [changedBy], references: [id])

  @@index([orderId, changedAt])
}

model ServiceBooking {
  id                      String                 @id @default(uuid()) @db.Uuid
  bookingNumber           String                 @unique
  userId                  String                 @db.Uuid
  serviceId               String                 @db.Uuid
  technicianId            String?                @db.Uuid
  serviceNameSnapshot     String
  basePriceSnapshot       Int
  durationMinutesSnapshot Int
  status                  BookingStatus          @default(requested)
  preferredStart          DateTime?
  scheduledStart          DateTime?
  scheduledEnd            DateTime?
  address                 String
  customerNotes           String                 @default("")
  technicianNotes         String                 @default("")
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  customer                User                   @relation("customerBookings", fields: [userId], references: [id])
  technician              User?                  @relation("technicianBookings", fields: [technicianId], references: [id])
  service                 Service                @relation(fields: [serviceId], references: [id])
  statusHistory           BookingStatusHistory[]

  @@index([userId, createdAt])
  @@index([technicianId, status, scheduledStart, scheduledEnd])
}

model BookingStatusHistory {
  id        String         @id @default(uuid()) @db.Uuid
  bookingId String         @db.Uuid
  from      BookingStatus?
  to        BookingStatus
  changedBy String         @db.Uuid
  changedAt DateTime       @default(now())
  booking   ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor     User           @relation(fields: [changedBy], references: [id])

  @@index([bookingId, changedAt])
}

model Review {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  productId        String   @db.Uuid
  rating           Int
  text             String
  verifiedPurchase Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, createdAt])
}

model Wishlist {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @unique @db.Uuid
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  WishlistProduct[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model WishlistProduct {
  wishlistId String   @db.Uuid
  productId  String   @db.Uuid
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([wishlistId, productId])
}

model Notification {
  id           String    @id @default(uuid()) @db.Uuid
  recipientId  String    @db.Uuid
  type         String
  title        String
  message      String
  resourceType String?
  resourceId   String?   @db.Uuid
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  recipient    User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
}

model SolutionRequest {
  id           String                 @id @default(uuid()) @db.Uuid
  userId       String                 @db.Uuid
  title        String
  requirements String
  status       SolutionStatus         @default(submitted)
  quotedPrice  Int?
  adminNotes   String                 @default("")
  expiresAt    DateTime?
  orderId      String?                @unique @db.Uuid
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  user         User                   @relation(fields: [userId], references: [id])
  order        Order?                 @relation(fields: [orderId], references: [id])
  productItems SolutionQuoteProduct[]
  services     SolutionQuoteService[]

  @@index([userId, createdAt])
  @@index([status])
}

model SolutionQuoteProduct {
  solutionId String          @db.Uuid
  productId  String          @db.Uuid
  quantity   Int
  solution   SolutionRequest @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id])

  @@id([solutionId, productId])
}

model SolutionQuoteService {
  solutionId String          @db.Uuid
  serviceId  String          @db.Uuid
  solution   SolutionRequest @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  service    Service         @relation(fields: [serviceId], references: [id])

  @@id([solutionId, serviceId])
}
